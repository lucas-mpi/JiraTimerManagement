<Window x:Class="JiraTimerManagement.TelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Jira Focus Timer — Tarefas &amp; Cerimônias"
        Width="475" Height="765"
        MinWidth="445" MinHeight="255"
        WindowStartupLocation="CenterScreen"
        Background="#121214"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <!-- Remove a barra azul padrão do Windows mantendo redimensionamento e sombra nativa -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Botão de Controle da Janela (Minimizar / Maximizar / Fechar) -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#F4F4F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Secundário Grafite Arredondado (Idêntico ao Artifact) -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#2E2E34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#27272A"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#3F3F46"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Primário Azul Arredondado (Idêntico ao Artifact) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="#1E1E22"/>
                                <Setter Property="Foreground" Value="#71717A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Vermelho de Parar -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Grafite Escuro para ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6" Background="#141417" BorderBrush="#2E2E34" BorderThickness="1"/>
                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A1A1AA"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,5,28,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#18181B" BorderThickness="1" BorderBrush="#2E2E34" CornerRadius="6" Margin="0,2,0,0"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#F4F4F5"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#27272A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de Rolagem Fina e Grafite -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3F3F46" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Moldura Externa Grafite com Borda Sutil (Sem a borda azul do Windows!) -->
    <Border BorderBrush="#27272A" BorderThickness="1" Background="#121214">
        <Grid>
            <DockPanel LastChildFill="True">

                <!-- 0. BARRA DE JANELA DISCRETA (Substitui a barra azul do Windows) -->
                <Border DockPanel.Dock="Top" Background="#0E0E11" BorderBrush="#1F1F23" BorderThickness="0,0,0,1" Padding="12,4"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <TextBlock Text="JIRA FOCUS TIMER — DESKTOP" FontSize="10" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource WinCtrlBtn}" Content="—" Click="BtnMinimizeWindow_Click" ToolTip="Minimizar"/>
                            <Button Style="{StaticResource WinCtrlBtn}" Content="□" Click="BtnMaximizeWindow_Click" ToolTip="Maximizar/Restaurar"/>
                            <Button Style="{StaticResource WinCtrlBtn}" Content="✕" Click="BtnCloseWindow_Click" ToolTip="Fechar"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. HEADER BAR DO APP (Idêntica ao Artifact) -->
                <Border DockPanel.Dock="Top" Background="#16161A" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,10"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="Bold">
                                <Run Text="⏱" Foreground="#0EA5E9"/>
                                <Run Text=" Jira Focus Timer" Foreground="#0EA5E9"/>
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                <Run Text="👤 " Foreground="#818CF8"/>
                                <Run x:Name="runUserDisplay" Text="Conectando ao Jira..." Foreground="#A1A1AA"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnTopMost" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Click="BtnTopMost_Click">
                                <TextBlock>
                                    <Run Text="📌 " Foreground="#F43F5E"/>
                                    <Run x:Name="runTopMostText" Text="Topo"/>
                                </TextBlock>
                            </Button>
                            <Button x:Name="btnMini" Style="{StaticResource SecondaryBtn}" Content="🗕 Mini" Margin="0,0,6,0" Click="BtnMini_Click"/>
                            <Button x:Name="btnConta" Style="{StaticResource SecondaryBtn}" Content="⚙ Conta" Click="BtnConta_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. PAINEL RETRÁTIL DE CONTA / LOGIN JIRA -->
                <Border x:Name="pnlAccount" DockPanel.Dock="Top" Visibility="Collapsed" Background="#18181C" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Autenticação Jira Cloud (Multi-usuário)" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                            <TextBlock Text="REST API v3" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <CheckBox x:Name="chkSimulation" Content="Modo Protótipo (Dados Simulados para Demonstração Rápida)"
                                  Foreground="#FACC15" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,10"
                                  Checked="ChkSimulation_Changed" Unchecked="ChkSimulation_Changed"/>

                        <TextBlock Text="URL da Organização" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                        <Border Background="#121215" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                            <TextBox x:Name="inpUrl" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" CaretBrush="#0EA5E9" FontSize="12"/>
                        </Border>

                        <TextBlock Text="E-mail do Desenvolvedor" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                        <Border Background="#121215" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                            <TextBox x:Name="inpEmail" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" CaretBrush="#0EA5E9" FontSize="12"/>
                        </Border>

                        <TextBlock Text="API Token" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                        <Border Background="#121215" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                            <PasswordBox x:Name="inpToken" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" CaretBrush="#0EA5E9" FontSize="12"/>
                        </Border>

                        <Button Content="Salvar Credenciais e Carregar Projetos" Style="{StaticResource PrimaryBtn}" Padding="10,7" Click="BtnSaveAccount_Click"/>
                    </StackPanel>
                </Border>

                <!-- 3. PAINEL DO CRONÔMETRO ATIVO + COMENTÁRIO RÁPIDO -->
                <Border x:Name="bdrActiveBanner" DockPanel.Dock="Top" Background="#18181C" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtActiveStatusBadge" Grid.Column="0" Text="⏸ NENHUMA TAREFA EM CONTAGEM"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtDigitalClock" Grid.Column="1" Text="00:00:00"
                                       FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock x:Name="txtActiveTaskKey" Text="Selecione uma tarefa ou cerimônia abaixo"
                                           FontSize="13.5" FontWeight="Bold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtActiveTaskSummary"
                                           Text="Ao clicar em ▶ Iniciar em outra atividade, a anterior é pausada e sincronizada com o comentário."
                                           FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button x:Name="btnStopMain" Grid.Column="1" Content="■ Parar &amp; Sincronizar"
                                    Style="{StaticResource SecondaryBtn}" IsEnabled="False" VerticalAlignment="Center" Padding="12,7" Click="BtnStopMain_Click"/>
                        </Grid>

                        <!-- Campo de Comentário Rápido com Placeholder -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Run Text="💬 " Foreground="#F4F4F5"/>
                                <Run Text="Comentário:" Foreground="#A1A1AA"/>
                            </TextBlock>
                            <Border Grid.Column="1" Background="#121215" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="6" Padding="8,5">
                                <Grid>
                                    <TextBlock Text="Ex: Ligação com suporte / Daily Scrum / Ajuste no cálculo..."
                                               Foreground="#71717A" FontSize="11.5" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=inpActiveComment}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="inpActiveComment" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" CaretBrush="#0EA5E9" FontSize="11.5"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. BARRA DE STATUS INFERIOR (RODAPÉ) -->
                <Border DockPanel.Dock="Bottom" Background="#16161A" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,7">
                    <TextBlock x:Name="txtFooterStatus" Text="✓ Pronto. Use ▶ Iniciar para contar ou + Manual / 💬 para lançar horas direto."
                               FontSize="11.5" FontWeight="Medium" Foreground="#E4E4E7" TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- 5. PAINEL DE HISTÓRICO DE WORKLOGS SINCRONIZADOS -->
                <Border x:Name="pnlHistorySection" DockPanel.Dock="Bottom" Background="#18181C" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,8" MaxHeight="95">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Últimos Apontamentos Sincronizados (Worklog + Comentário)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                            <TextBlock Text="Mínimo Jira: 1m (60s)" FontSize="11" Foreground="#71717A" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icSyncHistory">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#E4E4E7" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 6. CORPO PRINCIPAL (ABAS, FILTROS E LISTA DE CARDS) -->
                <DockPanel x:Name="pnlExpandableBody" LastChildFill="True">
                    <!-- Filtros e Abas -->
                    <Border DockPanel.Dock="Top" Background="#141417" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,10">
                        <StackPanel>
                            <!-- Linha 1: Abas Minhas Tarefas vs Cerimônias vs Todos os Cards -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnTabMine" Grid.Column="0"
                                        Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" Padding="8,7" Click="BtnTabMine_Click">
                                    <TextBlock>
                                        <Run Text="👤 " Foreground="#C7D2FE"/>
                                        <Run Text="Minhas Tarefas"/>
                                    </TextBlock>
                                </Button>
                                <Button x:Name="btnTabCeremonies" Grid.Column="1"
                                        Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0" Padding="8,7" Click="BtnTabCeremonies_Click">
                                    <TextBlock>
                                        <Run Text="🤝 " Foreground="#FBBF24"/>
                                        <Run Text="Cerimônias"/>
                                    </TextBlock>
                                </Button>
                                <Button x:Name="btnTabAllActive" Grid.Column="2"
                                        Style="{StaticResource SecondaryBtn}" Padding="8,7" Click="BtnTabAllActive_Click">
                                    <TextBlock>
                                        <Run Text="📋 " Foreground="#38BDF8"/>
                                        <Run Text="Todos Ativos"/>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <!-- Linha 2: Seletor de Projeto / Time -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Projeto / Time:" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="cmbProjects" Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectionChanged="CmbProjects_SelectionChanged"/>
                            </Grid>

                            <!-- Linha 3: Busca Rápida + Botão Atualizar -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#111113" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,8,0">
                                    <Grid>
                                        <TextBlock Text="Filtrar por código (ex: APP-100, Daily) ou título..."
                                                   Foreground="#71717A" FontSize="11.5" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=inpSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="inpSearch" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" CaretBrush="#0EA5E9" FontSize="11.5" TextChanged="InpSearch_TextChanged"/>
                                    </Grid>
                                </Border>
                                <Button x:Name="btnRefresh" Grid.Column="1" Content="↻ Atualizar" Style="{StaticResource SecondaryBtn}" Padding="12,5" Click="BtnRefresh_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Lista Rolável de Cards -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10,12,10">
                        <StackPanel x:Name="spTasks"/>
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>

            <!-- MODAL OVERLAY 1: LANÇAMENTO MANUAL DE HORAS + COMENTÁRIO -->
            <Grid x:Name="modalManualOverlay" Visibility="Collapsed" Background="#B3000000">
                <Border Background="#18181C" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="12"
                        Width="390" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="txtModalTitle" Text="Lançar Horas Manuais" FontSize="14" FontWeight="Bold" Foreground="#0EA5E9"/>
                            <Button Content="✕" Style="{StaticResource SecondaryBtn}" Padding="6,2" HorizontalAlignment="Right" Click="BtnCloseManualModal_Click"/>
                        </DockPanel>
                        <TextBlock x:Name="txtModalSummary" Text="" FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" MaxHeight="36" Margin="0,0,0,12"/>

                        <TextBlock Text="⏱ Tempo gasto (atalhos ou ex: 15m, 1h 30m):" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,6"/>
                        <UniformGrid Columns="6" Margin="0,0,0,8">
                            <Button Content="+15m" Style="{StaticResource SecondaryBtn}" Foreground="#38BDF8" Margin="0,0,4,0" Padding="2,4" Click="BtnPreset_Click" Tag="15m"/>
                            <Button Content="+30m" Style="{StaticResource SecondaryBtn}" Foreground="#38BDF8" Margin="0,0,4,0" Padding="2,4" Click="BtnPreset_Click" Tag="30m"/>
                            <Button Content="+45m" Style="{StaticResource SecondaryBtn}" Foreground="#38BDF8" Margin="0,0,4,0" Padding="2,4" Click="BtnPreset_Click" Tag="45m"/>
                            <Button Content="+1h" Style="{StaticResource SecondaryBtn}" Foreground="#38BDF8" Margin="0,0,4,0" Padding="2,4" Click="BtnPreset_Click" Tag="1h"/>
                            <Button Content="+1h30" Style="{StaticResource SecondaryBtn}" Foreground="#38BDF8" Margin="0,0,4,0" Padding="2,4" Click="BtnPreset_Click" Tag="1h 30m"/>
                            <Button Content="+2h" Style="{StaticResource SecondaryBtn}" Foreground="#38BDF8" Padding="2,4" Click="BtnPreset_Click" Tag="2h"/>
                        </UniformGrid>

                        <Border Background="#121215" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                            <TextBox x:Name="inpManualDuration" Text="15m" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" FontWeight="Bold" CaretBrush="#0EA5E9" FontSize="12.5"/>
                        </Border>

                        <TextBlock Text="💬 Comentário / Descrição:" FontSize="11.5" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,6"/>
                        <Border Background="#121215" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,14">
                            <TextBox x:Name="inpManualComment" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" Foreground="#F4F4F5" CaretBrush="#0EA5E9" FontSize="12"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Padding="14,6" Click="BtnCloseManualModal_Click"/>
                            <Button Content="✓ Lançar no Jira" Style="{StaticResource PrimaryBtn}" Padding="16,6" Click="BtnConfirmManualModal_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
